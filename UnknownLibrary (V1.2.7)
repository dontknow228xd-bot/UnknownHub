return function(opts)
    opts = opts or {}

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local CoreGui = game:GetService("CoreGui")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    local currentThemeColor = opts.theme or Color3.fromRGB(0, 180, 220)
    local themeLabels = {}
    local themeStrokes = {}
    local themeFrames = {}
    local allToggleSetters = {}
    local tabButtons = {}
    local tabPages = {}

    local function destroyOldGui()
        local parents = {CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}
        if gethui then pcall(function() table.insert(parents, gethui()) end) end
        for _, parent in ipairs(parents) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("ScreenGui") and child.Name == (opts.name or "ENI_TabbedHub_UI") then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        end
    end

    destroyOldGui()

    local function registerThemeText(lbl)
        table.insert(themeLabels, lbl)
        if lbl then lbl.TextColor3 = currentThemeColor end
    end

    local function registerThemeStroke(stroke)
        table.insert(themeStrokes, stroke)
        if stroke then stroke.Color = currentThemeColor end
    end

    local function registerThemeFrame(frm)
        table.insert(themeFrames, frm)
        if frm then frm.BackgroundColor3 = currentThemeColor end
    end

    local function applyCorner(obj)
        if not obj then return nil end
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = obj
        return c
    end

    local function makeSmoothDraggable(guiFrame, dragHandle)
        dragHandle = dragHandle or guiFrame
        if not guiFrame or not dragHandle then return end
        local dragging = false
        local dragInput, dragStart, startPos

        dragHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = guiFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        dragHandle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                local targetPos = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
                TweenService:Create(guiFrame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            end
        end)
    end

