        cancelBtn.Font = Enum.Font.GothamSemibold
        cancelBtn.TextSize = 12
        cancelBtn.ZIndex = 22
        cancelBtn.Parent = panel
        applyCorner(cancelBtn)

        local confirmBtn = Instance.new("TextButton")
        confirmBtn.Size = UDim2.new(0, 78, 0, 26)
        confirmBtn.Position = UDim2.new(0.5, 12, 1, -34)
        confirmBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        confirmBtn.Text = "Close"
        confirmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        confirmBtn.Font = Enum.Font.GothamBold
        confirmBtn.TextSize = 12
        confirmBtn.ZIndex = 22
        confirmBtn.Parent = panel
        applyCorner(confirmBtn)

        local originalPos = panel.Position
        panel.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset, originalPos.Y.Scale, originalPos.Y.Offset + 12)
        panel.Size = UDim2.new(0, 220, 0, 108)

        TweenService:Create(overlay, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.4}):Play()
        TweenService:Create(panel, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = originalPos, Size = UDim2.new(0, 240, 0, 120)}):Play()

        TweenService:Create(warnScale, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Scale = 1.12}):Play()
        TweenService:Create(warn, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Rotation = -12}):Play()

        local closeOverlay = function()
            if overlay.Parent then
                TweenService:Create(overlay, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
                TweenService:Create(panel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset, originalPos.Y.Scale, originalPos.Y.Offset + 10), Size = UDim2.new(0, 220, 0, 108)}):Play()
            end
            if blur and blur.Parent then blur.Size = 0 end
            task.delay(0.15, function()
                if overlay then overlay:Destroy() end
            end)
        end

        cancelBtn.MouseButton1Click:Connect(function()
            closeOverlay()
        end)

        confirmBtn.MouseButton1Click:Connect(function()
            if onConfirm then pcall(onConfirm) end
            closeOverlay()
        end)
    end

    local function DisableAllFeatureStates()
        pcall(function()
            for key, _ in pairs(getgenv()) do
                if type(key) == "string" and key:sub(1, 4) == "ENI_" then
                    getgenv()[key] = false
                end
            end
        end)

        for _, setter in ipairs(allToggleSetters) do
            pcall(function()
                if setter then setter(false) end
            end)
        end

        local cleanup = getgenv().ENI_Cleanup or _G.ENI_Cleanup
        if cleanup then
            pcall(cleanup)
        end
    end

    local localParent = opts.parent or (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = opts.name or "ENI_TabbedHub_UI"
