    end)

    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0, 150, 1, -46)
    sidebar.Position = UDim2.new(0, 0, 0, 46)
    sidebar.BackgroundColor3 = Color3.fromRGB(16, 19, 27)
    sidebar.BorderSizePixel = 0
    sidebar.Parent = mainFrame

    local contentArea = Instance.new("Frame")
    contentArea.Name = "ContentArea"
    contentArea.Size = UDim2.new(1, -150, 1, -46)
    contentArea.Position = UDim2.new(0, 150, 0, 46)
    contentArea.BackgroundTransparency = 1
    contentArea.Parent = mainFrame

    local function setTabVisible(tabName)
        for _, page in ipairs(tabPages) do
            if page and page.Name == tabName then
                page.Visible = true
            else
                if page then page.Visible = false end
            end
        end
        for _, btn in ipairs(tabButtons) do
            if btn and btn.Name == tabName then
                btn.BackgroundColor3 = Color3.fromRGB(35, 42, 60)
            else
                if btn then btn.BackgroundColor3 = Color3.fromRGB(24, 28, 40) end
            end
        end
    end

    local function createPage(name)
        local page = Instance.new("ScrollingFrame")
        page.Name = name
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.ScrollBarThickness = 4
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.Visible = false
        page.Parent = contentArea

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 8)
        pad.PaddingBottom = UDim.new(0, 8)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)
        pad.Parent = page

        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 8)
        layout.Parent = page
        table.insert(tabPages, page)
        return page
    end

    local function createTabButton(name, text, iconAssetId, defaultVisible)
        local page = createPage(name)
        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.Size = UDim2.new(0.92, 0, 0, 34)
        btn.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Parent = sidebar
        applyCorner(btn)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(230, 235, 245)
        lbl.Font = Enum.Font.GothamSemibold
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = btn

        btn.MouseButton1Click:Connect(function()
            setTabVisible(name)
        end)
        table.insert(tabButtons, btn)

        if defaultVisible then
            task.defer(function() setTabVisible(name) end)
        end

        return page
    end

    local function createButton(parent, text, callback)
        if not parent then parent = contentArea end
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, -10, 0, 36)
        item.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
        item.AutoButtonColor = false
        item.Text = "  " .. text
        item.TextColor3 = Color3.fromRGB(230, 235, 245)
        item.Font = Enum.Font.GothamBold
        item.TextSize = 12
        item.TextXAlignment = Enum.TextXAlignment.Left
        item.Parent = parent
        applyCorner(item)

        item.MouseButton1Click:Connect(function()
            if callback then pcall(callback) end
        end)
        return item
    end

    local function createToggle(parent, text, defaultState, callback)
        if not parent then parent = contentArea end
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, -10, 0, 42)
        frame.BackgroundColor3 = Color3.fromRGB(20, 25, 36)
        frame.BorderSizePixel = 0
        frame.Parent = parent
        applyCorner(frame)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.Position = UDim2.new(0.04, 0, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.fromRGB(230, 235, 245)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local switchTrack = Instance.new("Frame")
        switchTrack.Size = UDim2.new(0, 50, 0, 24)
        switchTrack.Position = UDim2.new(1, -60, 0.5, -12)
        switchTrack.BackgroundColor3 = (defaultState and true) and currentThemeColor or Color3.fromRGB(48, 54, 70)
        switchTrack.BorderSizePixel = 0
        switchTrack.Parent = frame
        applyCorner(switchTrack)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 20, 0, 20)
        knob.Position = defaultState and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.Parent = switchTrack
        applyCorner(knob)

        local state = defaultState or false
        local function setState(v)
            state = v
            local targetPos = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
            local targetColor = state and currentThemeColor or Color3.fromRGB(48, 54, 70)
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            TweenService:Create(switchTrack, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
            if callback then pcall(callback, state) end
        end

        local click = Instance.new("TextButton")
        click.Size = UDim2.new(1, 0, 1, 0)
        click.BackgroundTransparency = 1
        click.Text = ""
        click.Parent = frame
        click.MouseButton1Click:Connect(function() setState(not state) end)
        table.insert(allToggleSetters, setState)
        setState(state)
        return frame
    end

