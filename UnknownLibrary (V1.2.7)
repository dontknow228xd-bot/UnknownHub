    local function BringSelectedItem(list)
        if not list then return nil end
        if list.SelectedItem ~= nil then
            return list.SelectedItem
        end
        return nil
    end

    local function CreateList(parent, title, items, height, expanded)
        local parentTarget = parent
        local itemTitle = title or "List"
        local itemValues = items or {}
        local itemHeight = height or 160
        local itemExpanded = expanded ~= false

        if typeof(parentTarget) == "Instance" then
            if type(title) == "table" then
                itemValues = title
                itemTitle = "List"
                itemHeight = items or 160
                itemExpanded = height ~= false
            elseif type(items) == "number" then
                itemHeight = items or 160
                itemValues = {}
            end
        elseif type(parentTarget) == "table" and not parentTarget:IsA then
            itemValues = parentTarget
            parentTarget = contentArea
            itemTitle = title or "List"
            itemHeight = items or 160
            itemExpanded = height ~= false
        elseif type(parentTarget) == "string" then
            itemTitle = parentTarget
            parentTarget = title or contentArea
            itemValues = items or {}
            itemHeight = height or 160
            itemExpanded = expanded ~= false
        end

        if type(itemValues) ~= "table" then
            itemValues = {}
        end

        if not parentTarget then
            parentTarget = contentArea
        end

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, -10, 0, itemHeight)
        frame.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
        frame.BorderSizePixel = 0
        frame.Parent = parentTarget
        applyCorner(frame)

        local titleBtn = Instance.new("TextButton")
        titleBtn.Size = UDim2.new(1, 0, 0, 28)
        titleBtn.Text = " " .. tostring(itemTitle)
        titleBtn.TextColor3 = Color3.fromRGB(230, 235, 245)
        titleBtn.BackgroundColor3 = Color3.fromRGB(26, 31, 44)
        titleBtn.Font = Enum.Font.GothamBold
        titleBtn.TextSize = 12
        titleBtn.TextXAlignment = Enum.TextXAlignment.Left
        titleBtn.Parent = frame
        applyCorner(titleBtn)

        local list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1, 0, 1, -28)
        list.Position = UDim2.new(0, 0, 0, 28)
        list.BackgroundTransparency = 1
        list.ScrollBarThickness = 4
        list.Visible = itemExpanded
        list.Parent = frame

        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 6)
        layout.Parent = list

        local open = itemExpanded
        titleBtn.MouseButton1Click:Connect(function()
            open = not open
            list.Visible = open
            frame.Size = open and UDim2.new(1, -10, 0, itemHeight) or UDim2.new(1, -10, 0, 28)
        end)

        local listObject = {
            Frame = frame,
            List = list,
            SelectedItem = nil,
            Title = itemTitle,
            Items = itemValues,
            SetSelected = function(value)
                listObject.SelectedItem = value
                return value
            end,
            BringSelected = function()
                return BringSelectedItem(listObject)
            end,
        }

        local function addEntry(entry)
            local entryData = nil
            if type(entry) == "string" then
                entryData = {
                    Name = entry,
                    Desc = "",
                    Callback = nil,
                }
            elseif type(entry) == "table" then
                entryData = {
                    Name = entry.Name or entry[1] or entry.text or "Item",
                    Desc = entry.Desc or entry[2] or entry.desc or entry.subtitle or "",
                    Callback = entry.Callback or entry[3] or entry.callback,
                }
            end

            if not entryData then return end

            local row = createListItem(list, entryData.Name, entryData.Desc, function()
                listObject.SelectedItem = entryData
                if entryData.Callback then
                    pcall(entryData.Callback, entryData)
                end
            end)

            entryData.Row = row
            return row
        end

        for _, entry in ipairs(itemValues) do
            addEntry(entry)
        end

        return listObject
    end

    local defaultTab = createTabButton("Main", "Main", "rbxassetid://10723407389", true)

    return {
        gui = screenGui,
        frame = mainFrame,
        content = contentArea,
        addItem = function(titleText, subtitleText, callback)
            return createListItem(contentArea, titleText, subtitleText, callback)
        end,
        addToggle = function(titleText, defaultState, callback)
            return createToggle(contentArea, titleText, defaultState, callback)
        end,
        registerToggle = function(setter)
            if setter then table.insert(allToggleSetters, setter) end
        end,
        destroy = function()
            if screenGui then screenGui:Destroy() end
        end,
        disableAll = DisableAllFeatureStates,
        CreateButton = createButton,
        CreateToggle = createToggle,
        CreateList = CreateList,
        createTabButton = createTabButton,
        BringSelectedItem = BringSelectedItem,
        createPage = createPage,
        createSliderToggle = createToggle,
        addSectionDivider = function(parent)
            local line = Instance.new("Frame")
            line.Size = UDim2.new(1, -10, 0, 1)
            line.BackgroundColor3 = Color3.fromRGB(35, 42, 58)
            line.BorderSizePixel = 0
            line.Parent = parent or contentArea
            return line
        end,
    }
end
