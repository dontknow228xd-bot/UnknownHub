    local function setTabVisible(tabName)
        for _, page in ipairs(tabPages) do
            if page and page.Name == tabName then
                page.Visible = true
            else
                if page then page.Visible = false end
            end
        end
        for _, btn in ipairs(tabButtons) do
            if btn and btn.Name == tabName then
                TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(35, 42, 60)}):Play()
            else
                if btn then
                    TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(24, 28, 40)}):Play()
                end
            end
        end
    end

