    local function registerThemeText(lbl)
        table.insert(themeLabels, lbl)
        if lbl then lbl.TextColor3 = currentThemeColor end
    end

    local function registerThemeStroke(stroke)
        table.insert(themeStrokes, stroke)
        if stroke then stroke.Color = currentThemeColor end
    end

    local function registerThemeFrame(frm)
        table.insert(themeFrames, frm)
        if frm then frm.BackgroundColor3 = currentThemeColor end
    end

    local function applyTheme(color)
        currentThemeColor = color
        for _, label in ipairs(themeLabels) do
            if label and label.Parent then label.TextColor3 = currentThemeColor end
        end
        for _, stroke in ipairs(themeStrokes) do
            if stroke and stroke.Parent then stroke.Color = currentThemeColor end
        end
        for _, frame in ipairs(themeFrames) do
            if frame and frame.Parent then frame.BackgroundColor3 = currentThemeColor end
        end
        for _, updater in ipairs(themeUpdaters) do
            pcall(updater, currentThemeColor)
        end
    end

