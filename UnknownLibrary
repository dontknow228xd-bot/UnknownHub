        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = btn

        btn.MouseButton1Click:Connect(function()
            setTabVisible(name)
        end)
        table.insert(tabButtons, btn)

        if defaultVisible then
            task.defer(function() setTabVisible(name) end)
        end

        if name ~= "Config" and ensureConfigTab then
            task.defer(function()
                local ok, err = pcall(ensureConfigTab)
                if not ok then
                    warn("UnknownHub Config tab failed to initialize: " .. tostring(err))
                end
            end)
        end

        return page
    end

