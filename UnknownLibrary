        local function spawnZigZag()
            if not waveLayer.Parent then return end
            local zigZag = Instance.new("TextLabel")
            zigZag.Name = "FloatingZigZag"
            zigZag.Size = UDim2.new(0, 300, 0, 96)
            zigZag.AnchorPoint = Vector2.new(0.5, 0.5)
            zigZag.Position = UDim2.new(0, -160, math.random(12, 88) / 100, 0)
            zigZag.BackgroundTransparency = 1
            zigZag.Text = "╱╲╱╲"
            zigZag.TextColor3 = currentThemeColor
            zigZag.TextTransparency = 0.78
            zigZag.Font = Enum.Font.GothamBlack
            zigZag.TextSize = 76
            zigZag.TextXAlignment = Enum.TextXAlignment.Center
            zigZag.TextYAlignment = Enum.TextYAlignment.Center
            zigZag.Rotation = math.random(30, 45)
            zigZag.Active = false
            zigZag.ZIndex = 0
            zigZag.Parent = waveLayer

            local travelTime = math.random(42, 58) / 10
            local targetY = math.clamp(zigZag.Position.Y.Scale + math.random(-10, 10) / 100, 0.08, 0.92)
            local travel = TweenService:Create(zigZag, TweenInfo.new(travelTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, 160, targetY, 0),
            })
            travel.Completed:Connect(function()
                if zigZag and zigZag.Parent then zigZag:Destroy() end
            end)
            travel:Play()
        end

        task.spawn(function()
            while waveLayer.Parent do
                spawnZigZag()
                task.wait(1.15)
            end
        end)

        return waveLayer
    end

    local function makeSmoothDraggable(guiFrame, dragHandle)
        dragHandle = dragHandle or guiFrame
        if not guiFrame or not dragHandle then return end
        local dragging = false
        local dragInput, dragStart, startPos

        dragHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = guiFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        dragHandle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                local targetPos = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
                TweenService:Create(guiFrame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            end
        end)
    end

