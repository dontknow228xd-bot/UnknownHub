    local function checkFunction(name, callback, ...)
        if type(callback) ~= "function" then
            reportError(tostring(name or "Function") .. " is not a function")
            return false, "not a function"
        end
        local arguments = {...}
        local ok, result = xpcall(function()
            return callback(table.unpack(arguments))
        end, function(err)
            local message = tostring(err)
            reportError(tostring(name or "Function") .. ": " .. message)
            return message
        end)
        return ok, result
    end

